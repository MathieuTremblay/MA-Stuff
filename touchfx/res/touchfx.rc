// Windows resources: the app icon (desktop, Explorer, taskbar, window title bar) and version info.
#include <winver.h>

1 ICON "touchfx.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 0,9,4,3
PRODUCTVERSION 0,9,4,3
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "TouchFX - touch visuals with NDI output"
      VALUE "ProductName", "TouchFX"
      VALUE "FileVersion", "0.9.4.3"
      VALUE "ProductVersion", "0.9.4.3"
      VALUE "OriginalFilename", "TouchFX.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
